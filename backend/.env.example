APP_NAME=DeepDesk
HOST=127.0.0.1
PORT=8888
DEPLOYMENT_MODE=development

# OpenAI-compatible model endpoint. DashScope is the default target.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
OPENAI_TEMPERATURE=0.7

# Optional lightweight provider for File RAG query compression/MultiQuery.
# Leave empty to reuse OPENAI_*.
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_BASE_URL=
QUERY_REWRITE_MODEL=

# Optional multimodal provider for uploaded image understanding.
# Leave empty to reuse OPENAI_API_KEY/OPENAI_BASE_URL and IMAGE_MODEL.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# tavily or demo. demo keeps local verification independent of external credentials.
SEARCH_MODE=demo
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search

# memory keeps the local demo infrastructure-free; database enables durable Workspace assets.
# For the repository's local MySQL/PgVector/MinIO profile, see .env.fullstack.example.
PERSISTENCE_MODE=memory
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# File storage. Leave credentials empty in memory-only demo mode.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rag-test2
MINIO_SECURE=false
MINIO_PUBLIC_READ=true
MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=30
MINIO_MAX_RETRIES=2

MAX_FILE_SIZE_BYTES=52428800
LARGE_FILE_THRESHOLD_CHARS=5000
MAX_EXTRACTED_TEXT_CHARS=20000
FILE_CHUNK_SIZE_CHARS=500
FILE_CHUNK_OVERLAP_CHARS=50
IMAGE_MODEL=qwen3-vl-plus

# File RAG / PgVector configuration.
# Leave EMBEDDING_API_KEY/BASE_URL empty to reuse OPENAI_API_KEY/BASE_URL.
# Provider-specific Chat gateway configuration.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=9
VECTOR_DATABASE_URL=
VECTOR_TABLE_NAME=vector_file_info
VECTOR_CONNECT_TIMEOUT_SECONDS=5
RAG_TOP_K=5
RAG_MULTI_QUERY_COUNT=3

# Phase 3 Skills Agent. Local filesystem/grep/bash tools are restricted to this root.
SKILLS_WORKSPACE_ROOT=./agent-workspace
SKILLS_DIRECTORIES=./skills
SKILLS_MAX_FILE_SIZE_BYTES=10485760
SKILLS_READ_LINE_LIMIT=500
SKILLS_GREP_HEAD_LIMIT=250
SKILLS_BASH_ENABLED=false
SKILLS_BASH_TIMEOUT_SECONDS=30
SKILLS_BASH_MAX_OUTPUT_BYTES=100000
SKILLS_BASH_ALLOWED_COMMANDS=git
SKILLS_MAX_AGENT_ROUNDS=10
SKILLS_MAX_RETRIES=3
SKILLS_RETRY_INTERVAL_SECONDS=10
SKILLS_CONTEXT_TOKEN_THRESHOLD=60000
SKILLS_CONTEXT_KEEP_RECENT_TOOLS=4
SKILLS_CONTEXT_MAX_TOOL_LENGTH=200

# Phase 4 Plan-Execute Deep Research.
DEEP_MAX_ROUNDS=3
DEEP_CONTEXT_CHAR_LIMIT=50000
DEEP_TOOL_CONCURRENCY=3
DEEP_TOOL_RETRIES=2
DEEP_TASK_AGENT_ROUNDS=5

# Phase 5 PPT Builder. Uses the local render_ppt.py engine.
PPT_RENDER_SCRIPT_PATH=./resources/python/render_ppt.py
PPT_OUTPUT_DIR=./output/ppt
PPT_RENDER_TIMEOUT_SECONDS=300
PPT_SCHEMA_ENV_THRESHOLD_CHARS=20000
PPT_IMAGE_MODEL=qwen-image-plus
PPT_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
PPT_IMAGE_TIMEOUT_SECONDS=300
PPT_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30

# Distributed task manager. local is the safe dev/test default.
TASK_MANAGER_MODE=local
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
TASK_TTL_SECONDS=1800
TASK_TTL_REFRESH_SECONDS=300
TASK_STOP_TOPIC=agent:stop
TASK_KEY_PREFIX=agent:task:

MAX_AGENT_ROUNDS=5
REQUEST_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_SECONDS=0.5
PROVIDER_RETRY_MAX_SECONDS=5
PROVIDER_HTTP_MAX_CONNECTIONS=100
PROVIDER_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
PROVIDER_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
ENABLE_RECOMMENDATIONS=true

# Tracing. Keep disabled locally; production can export OTLP/HTTP to a Collector.
TRACING_ENABLED=false
TRACING_EXPORTER=none
TRACING_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
TRACING_SAMPLE_RATIO=1.0

# Rate limiting is off by default. Use redis for multi-instance production.
RATE_LIMIT_MODE=off
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PATH_PREFIXES=/agent/chat/stream,/agent/file/stream,/agent/skills/stream,/agent/deep/stream,/agent/pptx/stream,/file/upload
RATE_LIMIT_KEY_PREFIX=rate_limit:

# Optional Bearer API-key authentication. Production mode requires AUTH_MODE=api_key.
# Example shape: {"frontend":{"token":"<long-random-token>","scopes":["agent","file","session"]}}
AUTH_MODE=off
AUTH_API_KEYS_JSON={}
AUTH_PUBLIC_PATHS=/health,/health/live,/health/ready

# Development frontend defaults. Production requires explicit HTTPS non-local origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

