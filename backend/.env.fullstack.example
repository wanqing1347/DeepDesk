# DeepDesk local full-stack persistence profile.
# These credentials are development-only and match docker-compose.fullstack.yml.
# Prefer exporting these variables in the shell so your existing .env provider keys remain untouched.

PERSISTENCE_MODE=database
DATABASE_URL=mysql+pymysql://deepdesk:deepdesk_dev@127.0.0.1:3307/deepdesk?charset=utf8mb4

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=deepdesk
MINIO_SECRET_KEY=deepdesk_dev_secret
MINIO_BUCKET=rag-test2
MINIO_SECURE=false
MINIO_PUBLIC_READ=true

# Optional for large-file File RAG and readiness checks.
VECTOR_DATABASE_URL=postgresql+psycopg://deepdesk:deepdesk_dev@127.0.0.1:5434/deepdesk_vectors

# Single-instance local development can keep task coordination in-process.
TASK_MANAGER_MODE=local
